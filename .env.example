PORT=3000
NODE_ENV=development

DATABASE_URL=your_postgresql_connection_string
GEMINI_API_KEY=your_gemini_api_key

ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

GUEST_MINUTES=10
TRIAL_DAYS=1

PLAN_1_MONTH=35000
PLAN_2_MONTHS=55000
PLAN_3_MONTHS=99000

MULTICARD_API_URL=https://dev-mesh.multicard.uz
MULTICARD_APPLICATION_ID=your_multicard_application_id
MULTICARD_APPLICATION_SECRET=your_multicard_application_secret
MULTICARD_STORE_ID=your_multicard_store_id
MULTICARD_SECRET=your_multicard_secret

MULTICARD_CALLBACK_URL=https://teacherhasan.uz/api/payment/webhook
MULTICARD_RETURN_URL=https://teacherhasan.uz/


# ==============================================
